# Dockerfile.anaconda-e2e
#
# Layers the anaconda provisioner plugin onto the e2e image. The plugin is an
# out-of-tree exemplar rather than part of a release, so it is built here and
# not in the release Dockerfile.
#
# /workspace is where the base image built its manager. Building the plugin from
# the same path is what makes the recorded source paths agree, so plugin.Open
# accepts the .so.
ARG BUILD_IMAGE=docker.io/golang:1.26.6@sha256:640a234f4bea3e399c056b7b8f9c667c4939befae8db2f14e9785e16eccd4205
ARG BMO_IMAGE=quay.io/metal3-io/baremetal-operator:e2e

FROM $BUILD_IMAGE AS plugin
WORKDIR /workspace
COPY . .
ENV CGO_ENABLED=1
ENV GO111MODULE=on
ARG ARCH=amd64
ARG LDFLAGS=-s -w
RUN cd test/anaconda && GOOS=linux GOARCH=${ARCH} \
    go build -buildmode=plugin -ldflags "${LDFLAGS}" \
    -o /out/anaconda-provisioner.so ./plugin/

FROM $BMO_IMAGE
COPY --from=plugin /out/anaconda-provisioner.so /plugins/anaconda-provisioner.so
