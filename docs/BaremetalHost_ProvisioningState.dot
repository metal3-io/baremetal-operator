digraph BaremetalHost {
    rankdir=TB

    None [label="(none)", shape=house]
    Unmanaged [shape=doublecircle]
    Registering
    Inspecting
    Preparing
    Available [shape=doublecircle]
    Provisioning
    Provisioned [shape=doublecircle]
    ExternallyProvisioned [label="Externally\nProvisioned", shape=doublecircle]
    Deprovisioning
    PoweringOffBeforeDelete [label="Powering off\nbefore delete"]
    Deleting [shape=doublecircle]

    None -> Unmanaged [label="no BMC details"]
    None -> Registering [label="BMC details set"]

    Unmanaged -> Registering [label="BMC details set"]
    Unmanaged -> Deleting [label="deleted"]

    Registering -> Inspecting [label="!externallyProvisioned &&\n!inspectionDisabled"]
    Registering -> Preparing [label="!externallyProvisioned &&\ninspectionDisabled"]
    Registering -> ExternallyProvisioned [label="externallyProvisioned"]
    Registering -> Deleting [label="deleted"]

    Inspecting -> Preparing [label="done"]
    Inspecting -> PoweringOffBeforeDelete [label="deleted"]

    Preparing -> Available [label="done"]
    Preparing -> PoweringOffBeforeDelete [label="deleted"]

    Available -> Provisioning [label="NeedsProvisioning()"]
    Available -> Preparing [label="RAID / firmware\nsettings changed"]
    Available -> Inspecting [label="inspect annotation"]
    Available -> ExternallyProvisioned [label="externallyProvisioned"]
    Available -> PoweringOffBeforeDelete [label="deleted"]

    Provisioning -> Provisioned [label="done"]
    Provisioning -> Deprovisioning [label="failed, cancelled,\nor deleted"]

    Provisioned -> Deprovisioning [label="provisioningCancelled()\nor deleted"]

    ExternallyProvisioned -> Provisioned [label="!externallyProvisioned"]
    ExternallyProvisioned -> PoweringOffBeforeDelete [label="deleted"]

    Deprovisioning -> Available [label="done"]
    Deprovisioning -> PoweringOffBeforeDelete [label="deleted"]

    PoweringOffBeforeDelete -> Deleting [label="done"]
}
