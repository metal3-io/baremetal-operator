apiVersion: ironic.metal3.io/v1alpha1
kind: Ironic
metadata:
  name: ironic
  namespace: baremetal-operator-system
spec:
  version: "latest"
  networking:
    dhcp:
      rangeBegin: "${IRONIC_DHCP_RANGE_BEGIN}"
      rangeEnd: "${IRONIC_DHCP_RANGE_END}"
      networkCIDR: "${IRONIC_NETWORK_CIDR}"
      # Reserve IP addresses so we have a predictable IP, e.g. for the Live-ISO test.
      hosts:
      - "00:60:2f:31:81:01,${VM_HOST1_HOST}"
      - "00:60:2f:31:81:02,${VM_HOST2_HOST}"
    interface: "eth0"
    ipAddress: "${IRONIC_PROVISIONING_IP}"
    ipAddressManager: "keepalived"
  deployRamdisk:
    sshKey: "${SSH_PUB_KEY_CONTENT}"
    extraKernelParams: "console=ttyS0 bmo-e2e-kernel-params-ok sshkey=\"${SSH_PUB_KEY_CONTENT}\""
